{
  "name": "cursor-pocket-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "Local daemon that exposes the local chats of Cursor's Agents Window to a phone web app (read, notifications and, with Cursor's debug port, actions).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "pair": "node --disable-warning=ExperimentalWarning src/cli.js pair",
    "status": "node --disable-warning=ExperimentalWarning src/cli.js status",
    "probe": "node --disable-warning=ExperimentalWarning src/cli.js probe",
    "cdp": "node --disable-warning=ExperimentalWarning src/cli.js cdp",
    "demo": "node --disable-warning=ExperimentalWarning ../tools/demo-server.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\""
  }
}
